# Firebase Configuration
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional
VITE_API_BASE_URL=http://localhost:3000

# Maps (all free, no keys). OSRM road routing; empty string disables the
# network path and the app uses the offline Haversine fallback everywhere.
VITE_OSRM_BASE_URL=https://router.project-osrm.org
# Single-shot Nominatim geocoder (never autocomplete or bulk queries).
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
