# Glimmr API server configuration.
# Copy to `.env` (gitignored, never committed) and fill in real values,
# or export these variables in the host environment / secret manager.
#
# The server talks to the Glimmr Firebase project for Firestore.
# Credentials are NEVER stored here: point GOOGLE_APPLICATION_CREDENTIALS
# at a service-account JSON file that lives outside the repo.

# Port the API listens on (required by src/index.ts).
PORT=3000

# development | production. Production keeps CORS fail-closed and enables HSTS.
NODE_ENV=development

# Comma-separated browser-origin allowlist. Local Vite dev default
# (http://localhost:5173) is already allowed outside production.
CORS_ORIGIN=http://localhost:5173

# Glimmr Firebase project used for Firestore persistence.
FIREBASE_PROJECT_ID=glimmr-3b56a

# Absolute path to a service-account JSON key (outside the repo).
# Used by the Admin SDK via Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/glimmr-service-account.json

# Optional: point at a local Firestore emulator instead of the real project.
# When set, no service-account credentials are required.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
